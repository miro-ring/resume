<section class="yacha-reader not-prose" aria-label="야차의 시대 제1화 웹툰">
	<header class="reader-head">
		<strong>야차의 시대</strong>
		<span>제1화 「값을 내」</span>
	</header>

	<div class="strip">
		{#each panels as panel}
			<figure
				class={['panel', panel.scene ? 'scene-start' : '', panel.pause ? 'pause' : '']
					.filter(Boolean)
					.join(' ')}
				data-scene={panel.scene}
			>
				<img loading="lazy" decoding="async" src={panelSrc(panel.n)} alt={panelAlt(panel.n)} />
			</figure>
		{/each}
	</div>

</section>

